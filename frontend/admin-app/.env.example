# Backend gateway URL — Node.js gateway proxies to Spring Boot at /api/v1/*
# Production: point directly to the Render URL (skip the Node gateway).
VITE_API_BASE_URL=https://wood-furni.onrender.com/api/v1

# WebSocket gateway URL — connects to namespace /realtime (admins)
# NOTE: WebSocket is not enabled on the Render deployment yet. When added,
# set this to the gateway's URL (e.g. wss://wood-furni-gateway.onrender.com).
VITE_WS_URL=

# Display name
VITE_APP_NAME=WOODFURNI Admin
