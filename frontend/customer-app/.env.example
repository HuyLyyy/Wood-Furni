# Base URL for the WOODFURNI backend (Spring Boot).
# In dev: hit the Node.js gateway, which proxies to the backend.
# Leave scheme + host only; the gateway's own /api/v1/* routes are forwarded to Spring Boot.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Public re-exports so constants stay in sync
VITE_APP_NAME=WOODFURNI

# WebSocket gateway URL (Node.js gateway). Must be reachable from the browser.
# Defaults to the same host as the API (port 3000 = gateway).
VITE_WS_URL=http://localhost:3000