# Base URL for the WOODFURNI backend (Spring Boot on Render).
# In production: point directly to the Render URL (skip the Node gateway).
# In dev: use the Node.js gateway locally (http://localhost:3000/api/v1).
VITE_API_BASE_URL=https://wood-furni.onrender.com/api/v1

# Public re-exports so constants stay in sync
VITE_APP_NAME=WOODFURNI

# WebSocket gateway URL (Node.js gateway). Must be reachable from the browser.
# NOTE: WebSocket is not enabled on the Render deployment yet. When added,
# set this to the gateway's URL (e.g. wss://wood-furni-gateway.onrender.com).
VITE_WS_URL=
