# =============================================================================
# WOODFURNI — Environment variables cho docker compose
# =============================================================================
# Copy file này thành `.env` rồi chỉnh giá trị:
#   cp docker/.env.example docker/.env
#
# Lưu ý bảo mật:
# - KHÔNG commit file `.env` thật có chứa secret vào git (đã có trong .gitignore).
# - JWT_SECRET phải >= 32 ký tự để HS256 không lỗi.
# - Cùng JWT_SECRET phải dùng cho backend (Spring Boot) và gateway (Node.js) —
#   gateway dùng chính secret đó để verify JWT của client khi connect WebSocket.
# - GATEWAY_INTERNAL_SECRET là shared secret giữa backend và gateway cho
#   endpoint /internal/notify/* — KHÔNG nhất thiết giống JWT_SECRET.
# =============================================================================

# ---------- MongoDB ----------
MONGO_DATABASE=woodfurni

# ---------- JWT ----------
# Phải giống nhau cho backend và gateway.
# Generate nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-random-secret-at-least-32-chars-long

JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ---------- Gateway ----------
# Shared secret giữa backend và gateway cho /internal/notify/*
GATEWAY_INTERNAL_SECRET=internal-woodfurni-shared-secret-change-me

# CORS whitelist cho gateway (cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8082,http://localhost:8083

# ---------- Frontend (Vite) ----------
# URL public mà browser sẽ gọi tới gateway. Bake vào JS bundle lúc build —
# phải chạy lại `docker compose build` nếu đổi.
# - Khi chạy local:  http://localhost:3000 (port map của gateway service)
# - Khi chạy trong LAN: http://<host-ip>:3000
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# ---------- mongo-express (debug profile) ----------
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# =============================================================================
# TROUBLESHOOTING
# =============================================================================
# Nếu gặp lỗi khi build:
#   "EOF"
#   "Can't add file ... to tar: io: read/write on closed pipe"
#   "Docker Compose is configured to build using Bake, but buildkit isn't enabled"
#
# Nguyên nhân: Docker Compose v2.20+ bật BuildKit/Bake mặc định. Vài bản
# Docker Desktop cho Windows không tương thích với BuildKit khi build context
# nằm trên filesystem mount (WSL2/Hyper-V).
#
# Cách fix — dùng script wrapper đã ép classic builder:
#   cd docker
#   .\compose.ps1 build
#   .\compose.ps1 up -d
#
# Hoặc set env thủ công cho từng session:
#   $env:DOCKER_BUILDKIT=0
#   $env:COMPOSE_DOCKER_CLI_BUILD=0
#   docker compose build
# =============================================================================