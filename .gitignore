# =============================================================================
# WOODFURNI - Monorepo .gitignore
# Tech Stack: Node.js (Gateway) + Java/Spring Boot (Backend) + React (Frontend)
# =============================================================================

# --- Node.js / npm (Gateway) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm/
dist/
build/
*.tgz

# --- React / Vite (Frontend apps) ---
# Dependencies
frontend/customer-app/node_modules/
frontend/admin-app/node_modules/

# Build output
frontend/customer-app/dist/
frontend/admin-app/dist/

# Environment files (keep .env.example as template)
frontend/customer-app/.env
frontend/admin-app/.env
frontend/customer-app/.env.local
frontend/admin-app/.env.local
frontend/customer-app/.env.production
frontend/admin-app/.env.production

# Logs
frontend/customer-app/npm-debug.log*
frontend/admin-app/npm-debug.log*
frontend/customer-app/yarn-debug.log*
frontend/admin-app/yarn-debug.log*
frontend/customer-app/yarn-error.log*
frontend/admin-app/yarn-error.log*

# --- Java / Maven (Backend) ---
# Compiled class files
*.class

# Build directories
backend/furniture-api/target/
backend/furniture-api/build/
backend/furniture-api/out/

# Gradle (if used)
# backend/furniture-api/gradle/
# backend/furniture-api/gradlew
# backend/furniture-api/gradlew.bat
# backend/furniture-api/.gradle/

# IDE files
*.iml
*.ipr
*.iws
.idea/
*.swp
*.swo
*~
.DS_Store
.vscode/
*.log

# Package files (JARs)
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# --- Spring Boot ---
# Spring Boot native
backend/furniture-api/src/main/resources/application-local.yml
backend/furniture-api/src/main/resources/application-dev.yml
backend/furniture-api/src/main/resources/application-prod.yml
# Keep application.yml (default config)
# backend/furniture-api/src/main/resources/application.yml

# Spring Boot devtools
.spring-boot-devtools.properties

# --- Node Gateway ---
gateway/node-gateway/node_modules/
gateway/node-gateway/dist/
gateway/node-gateway/build/
gateway/node-gateway/.env
gateway/node-gateway/.env.local
gateway/node-gateway/.env.production

# --- MongoDB ---
*.lock
mongo.lock

# --- Docker ---
.env
.env.local
.env.*.local
docker-compose.override.yml
docker/.env
docker/.env.local

# --- Documentation artifacts ---
docs/testing/coverage/
docs/thesis/build/
*.pdf
*.docx

# --- Misc ---
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/

# --- OS specific ---
Thumbs.db
.DS_Store
Desktop.ini
$RECYCLE.BIN/

# --- Secrets & Credentials (NEVER commit) ---
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
secrets/
credentials/
