# Server
PORT=3000

# Must match JWT_SECRET in furniture-api/src/main/resources/application.yml
JWT_SECRET=your-super-secret-key-must-be-at-least-32-characters-long-for-hs256

# Shared secret between Spring Boot backend and gateway to call /internal/*
# Must match GATEWAY_INTERNAL_SECRET in backend application.yml
INTERNAL_SECRET=internal-woodfurni-shared-secret-change-me

# Allow CORS for local dev frontends (customer-app, admin-app)
CORS_ORIGINS=http://localhost:5173,http://localhost:8083