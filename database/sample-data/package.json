{
  "name": "woodfurni-seed",
  "version": "1.0.0",
  "description": "Sample data seeder for WOODFURNI MongoDB. Run with `node seed.node.js` (after `npm install`).",
  "private": true,
  "main": "seed.node.js",
  "scripts": {
    "seed": "node seed.node.js",
    "seed:mongosh": "mongosh \"${MONGODB_URI:-mongodb://localhost:27017/woodfurni}\" seed.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "mongodb": "^6.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
